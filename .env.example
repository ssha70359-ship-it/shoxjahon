# ---------- BAZA (Neon PostgreSQL) ----------
# Pooler (odatdagi ishlash uchun)
DATABASE_URL="postgresql://USER:PAROL@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct / unpooled (faqat migratsiya uchun - hostdan "-pooler" so'zi olib tashlangan)
DIRECT_URL="postgresql://USER:PAROL@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------- TELEGRAM ----------
BOT_TOKEN="1234567890:AAExampleTokenHere"
# "npm start" ngrok manzilini har safar shu yerga o'zi yozadi
WEBAPP_URL=""
# ngrok.com -> Your Authtoken (bo'lsa tunnel avtomatik ochiladi)
NGROK_AUTHTOKEN=""

# ---------- ADMIN ----------
# Admin panelga kirish paroli
ADMIN_PASSWORD="admin123"
# Admin Telegram ID (vergul bilan bir nechta bo'lishi mumkin)
ADMIN_IDS="123456789"
ADMIN_PANEL_URL="http://localhost:5174"

# ---------- SERVER ----------
PORT=5000

# Faqat serverda (Render) kerak. Render buni RENDER_EXTERNAL_URL orqali
# o'zi beradi, shuning uchun odatda bo'sh qoldiriladi.
PUBLIC_URL=""
# Bo'sh qoldirilsa: serverda webhook, kompyuterda long polling (avtomatik)
USE_WEBHOOK=""
NODE_ENV=development

# Brauzerdan (Telegramsiz) test qilish uchun. Productionda false qiling!
ALLOW_DEV_USER=False 
