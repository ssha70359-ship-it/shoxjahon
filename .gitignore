# ============================================
#  MAXFIY FAYLLAR — hech qachon GitHub'ga tushmaydi
# ============================================
.env
.env.*
*/.env
*/.env.*

# .env.example esa kerak — u namuna fayl, ichida parol yo'q
!.env.example
!*/.env.example

# Kalitlar va sertifikatlar
*.pem
*.key
*.p12
*.pfx
ngrok.yml

