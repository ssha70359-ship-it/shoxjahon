# ============================================
.cache/
.parcel-cache/
.turbo/
.vite/
*.tsbuildinfo
.eslintcache
.npm/
.temp/
.tmp/

# ============================================
#  PRISMA
# ============================================
# Avtomatik yaratiladigan client (npx prisma generate qayta yasaydi)
node_modules/.prisma/
prisma/generated/

# Lokal SQLite bazasi (agar ishlatilsa)
*.db
*.db-journal
prisma/dev.db*

# DIQQAT: prisma/migrations/ papkasi git'da SAQLANADI —
# uni ignore qilmang, aks holda baza jadvallari yo'qoladi.

