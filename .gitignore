# ============================================
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/
jspm_packages/

# ============================================
#  BUILD NATIJALARI
# ============================================
dist/
*/dist/
dist-ssr/
build/
*/build/
out/
.output/

