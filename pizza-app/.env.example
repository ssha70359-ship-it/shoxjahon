# ============================================================
#  Olov Pizza — sozlamalar. Nusxa oling: .env (npm run dev o'zi yaratadi)
# ============================================================

# --- Telegram ------------------------------------------------
# @BotFather dan olingan bot tokeni
BOT_TOKEN=

# Buyurtmalar tushadigan chat: oshxona guruhi (-100...) yoki o'z ID ingiz.
# Guruh ID sini bilish: botni guruhga qo'shing va @RawDataBot dan foydalaning.
ADMIN_CHAT_ID=

# Holatni o'zgartira oladigan xodimlar (vergul bilan). Bo'sh bo'lsa —
# ADMIN_CHAT_ID guruhidagi hamma.
ADMIN_IDS=

# --- Manzil --------------------------------------------------
# Mini App ochiladigan https manzil (serverda: https://sizning-domen.uz).
# Lokal ishda bo'sh qoldiring — NGROK_AUTHTOKEN bo'lsa npm run dev o'zi to'ldiradi.
PUBLIC_URL=
PORT=3000

# --- Ixtiyoriy -----------------------------------------------
# Onlayn to'lov: @BotFather → Payments → Click yoki Payme → token
PAYMENT_PROVIDER_TOKEN=

# @BotFather → /newapp orqali yaratilgan Mini App qisqa nomi.
# Bo'lsa, "Davra" havolasi botni chetlab to'g'ridan-to'g'ri ilovani ochadi.
MINIAPP_SHORT_NAME=

# Baza fayli (SQLite)
DATABASE_FILE=data/pizza.db

# --- Lokal sinov ---------------------------------------------
# https tunnel uchun: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Brauzerda Telegramsiz sinash (?dev=1, ?dev=2). Serverda (production) o'zi o'chadi.
ALLOW_DEV_USER=true

# Ish vaqtidan tashqarida ham buyurtma qabul qilish (faqat sinov uchun)
IGNORE_WORKING_HOURS=false
