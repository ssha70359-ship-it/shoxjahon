# ============================================================================
#  O'QUV MARKAZI BOTI - muhit sozlamalari
#  Nusxa oling:  cp .env.example .env
# ============================================================================

# ---------- BAZA (PostgreSQL / Neon / Supabase) ----------
# Odatdagi ishlash uchun (pooler)
DATABASE_URL="postgresql://USER:PAROL@host.neon.tech/lms?sslmode=require"
# Faqat migratsiya uchun (pooler'siz, ya'ni host nomida "-pooler" bo'lmagan manzil).
# BO'SH QOLDIRMANG: pooler ishlatmasangiz, DATABASE_URL bilan bir xil qiymatni yozing.
DIRECT_URL="postgresql://USER:PAROL@host.neon.tech/lms?sslmode=require"

# ---------- SERVER ----------
PORT=5000
NODE_ENV=development
# Backendning ommaviy HTTPS manzili. Payme/Click webhook'lari shu manzilga keladi.
# Render'da RENDER_EXTERNAL_URL avtomatik beriladi, shuning uchun odatda bo'sh qoldiriladi.
PUBLIC_URL=""
# Mini App manzili (Vercel yoki ngrok). Bot menyu tugmasi shu yerga bog'lanadi.
WEBAPP_URL=""
# Mini App domenlari uchun CORS ruxsati (vergul bilan). Bo'sh bo'lsa faqat WEBAPP_URL.
CORS_ORIGINS=""

# ---------- TELEGRAM ----------
BOT_TOKEN="1234567890:AAExampleTokenHere"
# Admin Telegram ID lari (vergul bilan) - yangi ariza va to'lov xabarlari shularga boradi
ADMIN_IDS="123456789"

# ---------- PAYME (Merchant API) ----------
# my.payme.uz -> Kassa -> Sozlamalar
PAYME_MERCHANT_ID=""
# Kassa kaliti (Merchant API uchun). Webhook Basic-auth paroli aynan shu.
PAYME_KEY=""
# Test rejimida kalit boshqacha bo'ladi - test kassa kalitini shu yerga yozing
PAYME_TEST_KEY=""
# To'lov sahifasi manzili (test uchun: https://test.paycom.uz)
PAYME_CHECKOUT_URL="https://checkout.paycom.uz"

# ---------- CLICK (Merchant API / SHOP API) ----------
# merchant.click.uz -> Xizmatlar
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_MERCHANT_USER_ID=""
# Xizmat maxfiy kaliti - imzo (sign_string) shu bilan tekshiriladi
CLICK_SECRET_KEY=""
CLICK_CHECKOUT_URL="https://my.click.uz/services/pay"

# ---------- XAVFSIZLIK ----------
# Brauzerdan (Telegramsiz) test qilish. Productionda ALBATTA false bo'lsin!
ALLOW_DEV_USER=false
